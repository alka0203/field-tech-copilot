# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Gemini Flash (free tier via Google AI Studio) — required for VLM extraction
# and pre-labeling. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Paid image search — optional. Scripts refuse to run without these set.
# Hard-capped by --max-queries flag; cannot silently burn budget.
BRAVE_API_KEY=your_brave_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
